# Copy this file to .env and replace every placeholder before running Docker.
PORT=3000
NODE_ENV=production

# PostgreSQL settings (used by both docker-compose and the API)
POSTGRES_DB=eatgym
POSTGRES_USER=eatgym
POSTGRES_PASSWORD=change-me

# Database connection (for local dev without Docker)
DATABASE_URL=postgresql://eatgym:change-me@localhost:5432/eatgym

# Use a randomly generated value of at least 32 characters. Never commit it.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=15m
JWT_ISSUER=eatgym-api
JWT_AUDIENCE=eatgym-mobile

# Set true only when connecting through a hosted database that requires TLS.
DATABASE_SSL=false

# Host port to expose the API (default 3000)
API_PORT=3000

# Host port to expose the AI service (default 8000)
AI_PORT=8000

# Ngrok Static Domain
NGROK_AUTHTOKEN=your-ngrok-authtoken
NGROK_DOMAIN=your-static-domain.ngrok-free.dev
